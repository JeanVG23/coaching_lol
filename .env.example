# Clé API Riot (https://developer.riotgames.com) — format RGAPI-...
RIOT_API_ID=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Ton Riot ID complet : gameName#tagLine
RIOT_ID=Faker#KR1

# Région PLATEFORME de ton compte (euw1, eun1, na1, kr, br1, ...)
# Le cluster régional (europe/americas/asia) en est déduit automatiquement.
RIOT_REGION=euw1

# Publication locale vers Cloudflare KV (voir web/README.md)
# Créer un jeton limité au namespace KV de production.
CF_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_NAMESPACE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Génération de coaching. En production, utiliser `wrangler secret put OLLAMA_API_KEY`
# plutôt qu'un fichier versionné.
OLLAMA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
