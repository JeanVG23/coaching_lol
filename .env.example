# Clé API Riot (https://developer.riotgames.com) — format RGAPI-...
RIOT_API_ID=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Ton Riot ID complet : gameName#tagLine
RIOT_ID=Faker#KR1

# Région PLATEFORME de ton compte (euw1, eun1, na1, kr, br1, ...)
# Le cluster régional (europe/americas/asia) en est déduit automatiquement.
RIOT_REGION=euw1
