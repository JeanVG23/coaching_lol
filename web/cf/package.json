{
  "name": "riftsense-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build",
    "preview": "vite preview",
    "deploy": "npm run build && WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc && vue-tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  }
}
